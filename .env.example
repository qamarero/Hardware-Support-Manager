# Supabase PostgreSQL connection string (pooler, transaction mode)
# Format: postgresql://[role].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
# HSM uses a dedicated 'hsm_app' role with its own schema 'hsm'
DATABASE_URL=postgresql://hsm_app.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# NextAuth.js
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
# OJO: dejar SIN DEFINIR en produccion.
# La app se sirve en dos dominios (soporte.hardware.qamarero.com y
# hardware-support-manager.vercel.app) y la config de auth usa trustHost, que
# construye las URLs con el dominio de cada peticion. Si NEXTAUTH_URL esta
# definida gana ella: entrar por el otro dominio te expulsa al canonico, las
# cookies se crean alli y la sesion no persiste al volver.
# En local si hace falta, porque no hay proxy que ponga el Host.
NEXTAUTH_URL=http://localhost:3000

# Vercel Blob (for file attachments)
BLOB_READ_WRITE_TOKEN=vercel-blob-token-here

# Intercom API
INTERCOM_ACCESS_TOKEN=your-intercom-access-token
INTERCOM_WEBHOOK_SECRET=your-intercom-webhook-secret
# Admin user ID that posts internal notes to Intercom from HSM sync.
# Obtain via: curl -s https://api.intercom.io/admins -H "Authorization: Bearer $INTERCOM_ACCESS_TOKEN" -H "Intercom-Version: 2.11"
# Pick the admin ID that should own automated notes (e.g. your support lead).
# REQUIRED for sync to work — without this, notes silently fail in Intercom.
INTERCOM_ADMIN_ID=your-intercom-admin-id

# External API (HW Main Portal integration)
# Shared secret used by the HW Main Portal to fetch /api/external/metrics
# Header expected: X-API-Key
MAIN_PORTAL_API_KEY=generate-with-openssl-rand-base64-32

# External API (Public incidents endpoint)
# Shared secret for /api/external/incidents — detailed incident data + PII.
# Used by third-party tools (CRM, analytics, etc.) authorized to access
# full incident data. Generate with: openssl rand -base64 32
# Header expected: X-API-Key
# REQUIRED if /api/external/incidents is consumed — otherwise returns 503.
HSM_PUBLIC_API_KEY=generate-with-openssl-rand-base64-32

# Sincronizacion de clientes desde CX Advisor
# Conexion de SOLO LECTURA al proyecto olcxbtvjkjmofrbvzpat, donde viven
# CX Advisor (schema core) y Toolbox (hw_staging).
#
# NO hace falta crear nada: es la MISMA variable y el MISMO rol de solo lectura
# (qarvis_ro) que ya usa Qarvis. Copiar el valor tal cual de las variables de
# entorno de Qarvis en Vercel.
#
# El acceso de QStatus Growth no sirve aqui: ese va por MCP HTTP con token, que
# vale para consultar a mano pero no para que un servidor sincronice.
#
# Sin esta variable, /api/cron/sync-clients responde 503 y no sincroniza nada.
OLCX_DATABASE_URL=postgresql://qarvis_ro:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Secreto de los cron jobs de Vercel.
# Vercel manda "Authorization: Bearer $CRON_SECRET" en cada ejecucion
# programada siempre que esta variable este definida en el proyecto.
# Sin ella, /api/cron/sync-clients responde 503 en vez de quedar abierto.
# Generar con: openssl rand -base64 32
CRON_SECRET=generate-with-openssl-rand-base64-32
